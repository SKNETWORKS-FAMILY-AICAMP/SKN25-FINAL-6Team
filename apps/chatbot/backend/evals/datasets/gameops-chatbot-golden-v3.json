      "voc": "Fixed-response evaluation. reference_answer == VOC_FIXED_RESPONSE constant from constants.py."
    },
    "rag_design": {
      "faq_mode": "multi_hop_rag",
      "scope": "FAQ examples combine two or more evidence claims such as condition + exception, path + alternative path, or rule + caveat.",
      "evaluation_note": "Keep metadata.test_type as faq for category filtering; use metadata.rag_mode or outputs.requires_multihop_rag for multi-hop RAG slices."
    }
  },
